{
  "name": "shakespeare-monologues-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.slshults/shakespeare-monologues",
  "description": "Read-only MCP server for shakespeare-monologues.org — search and fetch Shakespeare monologue metadata over the Model Context Protocol.",
  "license": "MIT",
  "author": "Steven Shults",
  "homepage": "https://www.shakespeare-monologues.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slshults/shakespeare-monologues-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/slshults/shakespeare-monologues-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "shakespeare",
    "monologues",
    "theatre",
    "acting",
    "audition"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "start:stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@posthog/mcp": "^0.22.1",
    "express": "^4.19.2",
    "posthog-node": "^5.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "bin": {
    "shakespeare-monologues-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
